+void OutputPaneManager::saveDetachedState() const
+{
+    QtcSettings *settings = ICore::settings();
+    QList<const OutputPaneData *> detached;
+    for (const OutputPaneData &data : std::as_const(g_outputPanes)) {
+        if (data.window)
+            detached.append(&data);
+    }
+    settings->beginWriteArray(outputPaneDetachedKeyC, detached.size());
+    for (int i = 0; i < detached.size(); ++i) {
+        settings->setArrayIndex(i);
+        settings->setValue(outputPaneIdKeyC, detached.at(i)->id.toSetting());
+        settings->setValue(outputPaneGeometryKeyC, detached.at(i)->window->saveGeometry());
+    }
+    settings->endArray();
+}
+
+void OutputPaneManager::detachPane(int idx)
+{
+    QTC_ASSERT(idx >= 0 && idx < g_outputPanes.size(), return);
+    OutputPaneData &data = g_outputPanes[idx];
+    if (data.window) {
+        showDetachedPane(idx, true);
+        return;
+    }
+    QTC_ASSERT(data.paneWidget && data.toolBar && data.pageHolder, return);
+    IOutputPane *pane = data.pane;
+    const bool wasShownInPanel = currentIndex() == idx
+                                 && OutputPanePlaceHolder::isCurrentVisible();
+
+    auto window = new DetachedOutputPaneWindow;
+    window->setWindowTitle(Tr::tr("%1 - Qt Creator").arg(pane->displayName()));
+
+    // Tool bar: clear, previous/next item, the pane's own tool bar, re-attach
+    auto bar = new StyledBar;
+    auto clearButton = new QToolButton;
+    clearButton->setIcon(Utils::Icons::CLEAN_TOOLBAR.icon());
+    clearButton->setToolTip(Tr::tr("Clear"));
+    auto prevButton = new QToolButton;
+    prevButton->setIcon(Utils::Icons::ARROW_UP_TOOLBAR.icon());
+    prevButton->setToolTip(Tr::tr("Previous Item"));
+    auto nextButton = new QToolButton;
+    nextButton->setIcon(Utils::Icons::ARROW_DOWN_TOOLBAR.icon());
+    nextButton->setToolTip(Tr::tr("Next Item"));
+    auto attachButton = new QToolButton;
+    attachButton->setIcon(Icons::CLOSE_SPLIT_BOTTOM.icon());
+    attachButton->setToolTip(Tr::tr("Move Back to Output Panel"));
+
+    auto barLayout = new QHBoxLayout(bar);
+    barLayout->setContentsMargins(0, 0, 0, 0);
+    barLayout->setSpacing(0);
+    barLayout->addWidget(clearButton);
+    barLayout->addWidget(prevButton);
+    barLayout->addWidget(nextButton);
+    barLayout->addWidget(data.toolBar, 1); // reparents the pane's tool bar
+    barLayout->addWidget(attachButton);
+    data.toolBar->show();
+
+    connect(clearButton, &QToolButton::clicked, pane, [pane] { pane->clearContents(); });
+    connect(prevButton, &QToolButton::clicked, pane, [pane] {
+        if (pane->canNavigate() && pane->canPrevious())
+            pane->goToPrev();
+    });
+    connect(nextButton, &QToolButton::clicked, pane, [pane] {
+        if (pane->canNavigate() && pane->canNext())
+            pane->goToNext();
+    });
+    const auto updateNavigation = [pane, prevButton, nextButton] {
+        prevButton->setEnabled(pane->canNavigate() && pane->canPrevious());
+        nextButton->setEnabled(pane->canNavigate() && pane->canNext());
+    };
+    connect(pane, &IOutputPane::navigateStateUpdate, window, updateNavigation);
+    updateNavigation();
+    connect(attachButton, &QToolButton::clicked, window, &QWidget::close);
+
+    auto windowLayout = new QVBoxLayout(window);
+    windowLayout->setContentsMargins(0, 0, 0, 0);
+    windowLayout->setSpacing(0);
+    windowLayout->addWidget(bar);
+    windowLayout->addWidget(data.paneWidget, 1); // reparents the pane's widget
+    windowLayout->addWidget(new FindToolBarPlaceHolder(window));
+    data.paneWidget->show();
+    window->setFocusProxy(data.paneWidget);
+
+    // Placeholder shown in the output panel while the pane is detached
+    if (!data.detachedPlaceholder) {
+        auto placeholder = new QWidget;
+        auto label = new QLabel(Tr::tr("%1 is shown in a separate window.")
+                                    .arg(pane->displayName()));
+        label->setAlignment(Qt::AlignCenter);
+        auto showButton = new QPushButton(Tr::tr("Show Window"));
+        auto backButton = new QPushButton(Tr::tr("Move Back Here"));
+        connect(showButton, &QPushButton::clicked, this, [this, pane] {
+            const int i = indexOfPane(pane);
+            if (i >= 0)
+                showDetachedPane(i, true);
+        });
+        connect(backButton, &QPushButton::clicked, this, [pane] {
+            const int i = indexOfPane(pane);
+            if (i >= 0 && g_outputPanes.at(i).window)
+                g_outputPanes.at(i).window->close();
+        });
+        auto buttons = new QHBoxLayout;
+        buttons->addStretch();
+        buttons->addWidget(showButton);
+        buttons->addWidget(backButton);
+        buttons->addStretch();
+        auto placeholderLayout = new QVBoxLayout(placeholder);
+        placeholderLayout->addStretch();
+        placeholderLayout->addWidget(label);
+        placeholderLayout->addLayout(buttons);
+        placeholderLayout->addStretch();
+        data.pageHolder->layout()->addWidget(placeholder);
+        data.detachedPlaceholder = placeholder;
+    }
+    data.detachedPlaceholder->show();
+    data.pageHolder->setFocusProxy(nullptr);
+
+    window->onClose = [this, pane] { reattachPane(pane); };
+    data.window = window;
+
+    if (data.detachedGeometry.isEmpty() || !window->restoreGeometry(data.detachedGeometry))
+        window->resize(900, 450);
+    window->show();
+    pane->visibilityChanged(true);
+
+    if (wasShownInPanel)
+        slotHide();
+}
+
+void OutputPaneManager::reattachPane(IOutputPane *pane)
+{
+    const int idx = indexOfPane(pane);
+    QTC_ASSERT(idx >= 0, return);
+    OutputPaneData &data = g_outputPanes[idx];
+    if (!data.window)
+        return;
+
+    data.detachedGeometry = data.window->saveGeometry();
+    data.window->setFocusProxy(nullptr);
+
+    if (data.toolBar) {
+        data.toolBarHolder->layout()->addWidget(data.toolBar);
+        data.toolBar->show();
+    }
+    if (data.detachedPlaceholder)
+        data.detachedPlaceholder->hide();
+    if (data.paneWidget) {
+        data.pageHolder->layout()->addWidget(data.paneWidget);
+        data.paneWidget->show();
+        data.pageHolder->setFocusProxy(data.paneWidget);
+    }
+    data.window = nullptr; // the window deletes itself (WA_DeleteOnClose)
+
+    if (!m_shuttingDown) {
+        const bool visibleInPanel = currentIndex() == idx
+                                    && OutputPanePlaceHolder::isCurrentVisible();
+        pane->visibilityChanged(visibleInPanel);
+        if (data.button)
+            data.button->setChecked(visibleInPanel);
+    }
+}
+
+void OutputPaneManager::showDetachedPane(int idx, bool withFocus)
+{
+    QTC_ASSERT(idx >= 0 && idx < g_outputPanes.size(), return);
+    const OutputPaneData &data = g_outputPanes.at(idx);
+    QTC_ASSERT(data.window, return);
+    DetachedOutputPaneWindow *window = data.window;
+    if (window->isMinimized())
+        window->showNormal();
+    else
+        window->show();
+    if (withFocus) {
+        ICore::raiseWindow(window);
+        if (data.pane->canFocus())
+            data.pane->setFocus();
+    } else {
+        window->raise(); // don't steal focus, e.g. when starting an application
+    }
 }
 
