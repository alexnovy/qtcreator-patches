+// Top-level window that hosts a detached output pane.
+// Closing it puts the pane back into the bottom output panel.
+class DetachedOutputPaneWindow : public QWidget
+{
+public:
+    DetachedOutputPaneWindow()
+        : QWidget(nullptr, Qt::Window)
+    {
+        setAttribute(Qt::WA_DeleteOnClose);
+        setAttribute(Qt::WA_QuitOnClose, false);
+    }
+
+    std::function<void()> onClose;
+
+protected:
+    void closeEvent(QCloseEvent *e) override
+    {
+        if (onClose) {
+            const std::function<void()> f = std::move(onClose);
+            onClose = {};
+            f();
+        }
+        QWidget::closeEvent(e);
+    }
+};
+
+} // namespace Internal
