+bool NavigationWidget::isDetached() const
+{
+    return d->m_detached;
+}
+
+void NavigationWidget::setDetached(bool detached)
+{
+    if (d->m_detached == detached) {
+        if (detached)
+            setShown(true);
+        return;
+    }
+
+    NavigationWidgetPlaceHolder *current = NavigationWidgetPlaceHolder::current(d->m_side);
+
+    if (detached) {
+        auto window = new SidebarWindow;
+        window->setWindowTitle(d->m_side == Side::Left ? Tr::tr("Left Sidebar - Qt Creator")
+                                                       : Tr::tr("Right Sidebar - Qt Creator"));
+        window->layout()->addWidget(this); // reparents the sidebar
+        show();
+        if (current)
+            current->setVisible(false);
+
+        d->m_detached = true;
+        d->m_shown = true;
+        d->m_window = window;
+        window->onClose = [this] { setDetached(false); };
+        // Keep the window out of the way while Qt Creator shuts down;
+        // the detached state is still saved.
+        if (ICore::instance()) {
+            connect(ICore::instance(), &ICore::coreAboutToClose, window, [window] {
+                window->onClose = {};
+                window->hide();
+            });
+        }
+
+        if (d->m_windowGeometry.isEmpty() || !window->restoreGeometry(d->m_windowGeometry))
+            window->resize(qMax(d->m_width, 300), 700);
+        window->show();
+    } else {
+        SidebarWindow *window = d->m_window;
+        d->m_detached = false;
+        d->m_window = nullptr;
+        if (window)
+            d->m_windowGeometry = window->saveGeometry();
+
+        if (current) {
+            current->layout()->addWidget(this);
+            show();
+            current->applyStoredSize();
+            current->setVisible(d->m_shown && d->m_factoryModel->rowCount());
+        } else {
+            setParent(nullptr);
+            hide();
+        }
+
+        if (window && !window->isClosing) {
+            window->onClose = {};
+            window->close(); // deletes itself
+        }
+    }
+
+    updateToggleAction();
+    emit detachedChanged(detached);
+}
