+Bookmark *BookmarkManager::numberedBookmark(int number) const
+{
+    return Utils::findOrDefault(m_bookmarksList, Utils::equal(&Bookmark::number, number));
+}
+
+// Takes the number away from a bookmark. A bookmark that only existed because
+// of its number (no note) is removed completely.
+void BookmarkManager::releaseNumber(Bookmark *bookmark)
+{
+    if (bookmark->note().isEmpty()) {
+        deleteBookmark(bookmark);
+    } else {
+        bookmark->setNumber(-1);
+        updateBookmark(bookmark);
+    }
+}
+
+void BookmarkManager::setNumberedBookmark(int number, const FilePath &filePath, int lineNumber)
+{
+    if (lineNumber <= 0 || filePath.isEmpty())
+        return;
+
+    Bookmark *here = findBookmark(filePath, lineNumber);
+    Bookmark *withNumber = numberedBookmark(number);
+
+    // Same number on the same line again: toggle it off
+    if (here && here == withNumber) {
+        releaseNumber(here);
+        return;
+    }
+
+    // The number moves here from wherever it was before
+    if (withNumber)
+        releaseNumber(withNumber);
+
+    if (!here) {
+        toggleBookmark(filePath, lineNumber);
+        here = findBookmark(filePath, lineNumber);
+        QTC_ASSERT(here, return);
+    }
+    here->setNumber(number); // replaces a different number the bookmark may have had
+    updateBookmark(here);
+    updateActionStatus();
+}
+
+void BookmarkManager::gotoNumberedBookmark(int number)
+{
+    Bookmark *bookmark = numberedBookmark(number);
+    if (!bookmark)
+        return;
+    if (gotoBookmark(bookmark)) {
+        const int row = m_bookmarksList.indexOf(bookmark);
+        if (row >= 0) {
+            selectionModel()->setCurrentIndex(index(row, 0, QModelIndex()),
+                                              QItemSelectionModel::Select
+                                                  | QItemSelectionModel::Clear);
+        }
+    }
+}
