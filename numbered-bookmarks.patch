 const char BOOKMARKS_TEXT_MARK_CATEGORY[] = "Bookmarks.TextMarkCategory";
 
+// The bookmark icon with the bookmark's number drawn on top of it
+static QIcon numberedBookmarkIcon(int number)
+{
+    static QHash<int, QIcon> cache;
+    const auto it = cache.constFind(number);
+    if (it != cache.constEnd())
+        return *it;
+
+    const QIcon base = Icons::BOOKMARK_TEXTEDITOR.icon();
+    const QString text = QString::number(number);
+    QIcon result;
+    for (const int size : {16, 24, 32, 48, 64}) {
+        QPixmap pixmap = base.pixmap(QSize(size, size), 1.0);
+        if (pixmap.isNull()) {
+            pixmap = QPixmap(size, size);
+            pixmap.fill(Qt::transparent);
+        }
+        const QRectF rect = pixmap.rect();
+        QPainter painter(&pixmap);
+        painter.setRenderHint(QPainter::Antialiasing);
+        QFont font = painter.font();
+        font.setBold(true);
+        font.setPixelSize(qMax(8, int(rect.height() * 0.8)));
+        const QRectF textRect = QFontMetricsF(font).tightBoundingRect(text);
+        QPainterPath path;
+        path.addText(rect.center() - textRect.center(), font, text);
+        painter.strokePath(path, QPen(QColor(0, 0, 0, 200), qMax(1.5, rect.height() / 8.0),
+                                      Qt::SolidLine, Qt::RoundCap, Qt::RoundJoin));
+        painter.fillPath(path, Qt::white);
+        painter.end();
+        result.addPixmap(pixmap);
+    }
+    cache.insert(number, result);
+    return result;
+}
